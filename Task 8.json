[
    import http from 'http';
import fs from 'fs';
import path from 'path';

const filePath = path.join(process.cwd(), 'books.json');

function readBooks() {
  try {
    if (!fs.existsSync(filePath)) return [];
    const data = fs.readFileSync(filePath, 'utf8');
    return JSON.parse(data || '[]');
  } catch (err) {
    return [];
  }
}

function saveBooks(books) {
  try {
    fs.writeFileSync(filePath, JSON.stringify(books, null, 2));
    return true;
  } catch (err) {
    return false;
  }
}

const server = http.createServer((req, res) => {
  const { method, url } = req;

  if (method === 'GET' && url === '/books') {
    const books = readBooks();
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify(books));
  }

  if (method === 'POST' && url === '/books') {
    let body = '';
    req.on('data', chunk => {
      body += chunk.toString();
    });

    req.on('end', () => {
      try {
        const parsedData = JSON.parse(body);
        const books = readBooks();
        const newBook = {
          id: Date.now(),
          title: parsedData.title,
          author: parsedData.author,
          price: parsedData.price,
          available: parsedData.available ?? true
        };

        books.push(newBook);
        
        if (!saveBooks(books)) {
          res.writeHead(500, { 'Content-Type': 'application/json' });
          return res.end(JSON.stringify({ error: 'Failed to write to file' }));
        }

        res.writeHead(201, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify(newBook));
      } catch (err) {
        res.writeHead(400, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ error: 'Invalid JSON body' }));
      }
    });
    return;
  }

  if (method === 'DELETE' && url.startsWith('/books/')) {
    const id = parseInt(url.split('/')[2]);
    
    if (isNaN(id)) {
      res.writeHead(400, { 'Content-Type': 'application/json' });
      return res.end(JSON.stringify({ error: 'Invalid book ID' }));
    }

    const books = readBooks();
    const filteredBooks = books.filter(book => book.id !== id);

    if (books.length === filteredBooks.length) {
      res.writeHead(404, { 'Content-Type': 'application/json' });
      return res.end(JSON.stringify({ error: 'Book not found' }));
    }

    if (!saveBooks(filteredBooks)) {
      res.writeHead(500, { 'Content-Type': 'application/json' });
      return res.end(JSON.stringify({ error: 'Failed to write to file' }));
    }

    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify({ message: 'Book deleted successfully' }));
  }

  res.writeHead(404, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ error: 'Route not found' }));
});

server.listen(3000, () => {
  console.log('Server running on port 3000');
});
]