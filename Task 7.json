[

import fs from 'fs';

function saveGrades(grades) {
  fs.writeFileSync('./data/grades.json', JSON.stringify(grades, null, 2));
}

function readGrades() {
  if (!fs.existsSync('./data/grades.json')) return [];
  const data = fs.readFileSync('./data/grades.json', 'utf8');
  return JSON.parse(data || '[]');
}

function addGrade(name, subject, grade) {
  const grades = readGrades();
  const newRecord = { id: Date.now(), name, subject, grade };
  grades.push(newRecord);
  saveGrades(grades);
  return newRecord;
}

function updateGrade(id, newGrade) {
  const grades = readGrades();
  const index = grades.findIndex(item => item.id === id);
  if (index !== -1) {
    grades[index].grade = newGrade;
    saveGrades(grades);
    return true;
  }
  return false;
}

function deleteGrade(id) {
  const grades = readGrades();
  const filtered = grades.filter(item => item.id !== id);
  if (filtered.length !== grades.length) {
    saveGrades(filtered);
    return true;
  }
  return false;
}

const student1 = addGrade('Alice', 'Math', 95);
const student2 = addGrade('Bob', 'Physics', 82);

console.log('Grades after adding:', readGrades());

updateGrade(student1.id, 98);
console.log('Grades after update:', readGrades());

deleteGrade(student2.id);
console.log('Grades after deletion:', readGrades());
]